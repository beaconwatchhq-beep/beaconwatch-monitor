# Which estimator to use: 'stub' (deterministic fake, for dev) or 'model' (real weights)
DEER_MODEL=stub

# Path to the real model's weights (only used when DEER_MODEL=model)
DEER_MODEL_WEIGHTS=./weights/model.pt

# Directory where uploaded photos are stored
DEER_UPLOAD_DIR=./uploads

# SQLite database path
DEER_DB_PATH=./deer.db

# bcrypt hash of the admin password. Generate with: python auth.py "your-password"
DEER_ADMIN_HASH=
